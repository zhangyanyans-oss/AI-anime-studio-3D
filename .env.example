# 密钥配置模板：复制本文件为 .env 后填入自己的真实密钥
# ⚠️ .env 含真实密钥，已被 .gitignore 排除，切勿提交到仓库

# DeepSeek（剧本创作）https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 火山方舟（分镜图 · 豆包 seedream）https://console.volcengine.com/ark
ARK_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxx
DOUBAO_MODEL=doubao-seedream-5-0-flash-260915
DOUBAO_BASE=https://ark.cn-beijing.volces.com/api/v3

# AutoDL.Art 令牌（视频生成，创建令牌时分组必须选 ComfyUI）
# https://autodl.art/large-model/tokens
AUTODL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
AUTODL_WORKFLOW_ID=minimax_h3_zm_u24

# 可选：首尾帧模式工作流 ID（默认 minimax_h3_lightx2v，前端可改）
# AUTODL_I2V_TOKEN=
# AUTODL_BASE=https://autodl.art
